 visualizes “Intent Bubbles”—zones of the motor cortex lighting up before a physical action is taken.","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"key":"AIyyZAJKTs"}],"key":"FaKiBiUUCM"}],"key":"PD5xLuDvkF"},{"type":"listItem","spread":true,"position":{"start":{"line":53,"column":1},"end":{"line":54,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Synergy: If SciStream detects a lag in the neural-to-digital link, syGlass can highlight the “bottleneck” area in red within the Commander’s field of view, allowing for an immediate tactical swap or mission abort.","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"key":"J6FxUnHD4I"}],"key":"UVoJcN2pjQ"}],"key":"Y8VrXL9q28"}],"key":"TQtPaCwa97"},{"type":"heading","depth":4,"position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"children":[{"type":"text","value":"“Augmented Intent”","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"key":"tBmboQblzr"}],"identifier":"augmented-intent","label":"“Augmented Intent”","html_id":"augmented-intent","implicit":true,"key":"OPWlE6lZsO"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":56,"column":1},"end":{"line":58,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Sensory Injection: The Commander can “push” tactical data directly into the user’s sensory perception. For example, injecting a “thermal sense” or “spatial ping” into the user’s parietal lobe, allowing them to “feel” an enemy’s location without looking at a screen.","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"key":"cQxnWbJ7VE"}],"key":"pj8nM4MPZl"}],"key":"W1RqJQv5sp"},{"type":"listItem","spread":true,"position":{"start":{"line":57,"column":1},"end":{"line":58,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Focus Steering: By manipulating the XR dashboard, the Commander can boost the user’s visual processing or auditory gain during high-stress moments, effectively “tuning” the user’s brain for the mission.","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"NQasiiEZlF"}],"key":"Ua3qm6N0n7"}],"key":"kRy9jCVEgV"}],"key":"pzuHJrArwe"},{"type":"heading","depth":3,"position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"children":[{"type":"text","value":"For the Physician:","position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"key":"m1doeXNKYK"}],"identifier":"for-the-physician","label":"For the Physician:","html_id":"for-the-physician","implicit":true,"key":"wXpjo8c3oK"},{"type":"heading","depth":4,"position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"children":[{"type":"text","value":"“Precision Diagnostic Suite”","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"key":"jeOcqDO05B"}],"identifier":"precision-diagnostic-suite","label":"“Precision Diagnostic Suite”","html_id":"precision-diagnostic-suite","implicit":true,"key":"eR0JzjlpRp"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":61,"column":1},"end":{"line":63,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"syGlass Implementation: Enables “Virtual Micro-Slicing.” The Physician can freeze a SciStream live-feed and use syGlass tools to measure the density of neural firing or track electrode degradation in 1:1 scale.","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"key":"SETWqqnTUj"}],"key":"XjlimFJHN2"}],"key":"y7PBiypFow"},{"type":"listItem","spread":true,"position":{"start":{"line":62,"column":1},"end":{"line":63,"column":1}},"children":[{"type":"paragraph","children":[{